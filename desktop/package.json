{
  "name": "sirjoe-mtb-planner",
  "productName": "SirJoe MTB Planner",
  "version": "1.7.0",
  "description": "Pianificatore di percorsi MTB per Windows e Mac, compagno dell'app Android SirJoe MTB",
  "main": "main.js",
  "author": "SirJoe",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "geotiff": "^2.1.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "pmtiles": "^3.2.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "it.sirjoe.mtbplanner",
    "productName": "SirJoe MTB Planner",
    "files": [
      "main.js",
      "preload.js",
      "link-server.js",
      "map-sources.js",
      "app/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "SirJoe-MTB-Planner-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "SirJoe-MTB-Planner-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SirJoe MTB Planner"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.sports",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "SirJoe-MTB-Planner-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "SirJoe MTB Planner ${version}",
      "artifactName": "SirJoe-MTB-Planner-${version}-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 330,
          "type": "file",
          "path": "build/LEGGIMI - Installazione Mac.txt"
        }
      ]
    }
  }
}
