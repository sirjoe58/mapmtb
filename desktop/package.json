{
  "name": "sirjoe-mtb-planner",
  "productName": "SirJoe MTB Planner",
  "version": "1.4.0",
  "description": "Pianificatore di percorsi MTB per Windows, compagno dell'app Android SirJoe MTB",
  "main": "main.js",
  "author": "SirJoe",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "geotiff": "^2.1.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "pmtiles": "^3.2.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "it.sirjoe.mtbplanner",
    "productName": "SirJoe MTB Planner",
    "files": [
      "main.js",
      "preload.js",
      "link-server.js",
      "map-sources.js",
      "app/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "SirJoe-MTB-Planner-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "SirJoe-MTB-Planner-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SirJoe MTB Planner"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ]
  }
}
