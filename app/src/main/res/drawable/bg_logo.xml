<?xml version="1.0" encoding="utf-8"?>
<!-- Badge ovale del logo "BY SIRJOE": arancio caldo sfumato, bordo bianco -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <gradient
        android:angle="0"
        android:endColor="@color/sj_red"
        android:startColor="@color/sj_orange" />
    <stroke
        android:width="1.5dp"
        android:color="@color/white" />
    <padding
        android:bottom="4dp"
        android:left="12dp"
        android:right="12dp"
        android:top="4dp" />
</shape>
