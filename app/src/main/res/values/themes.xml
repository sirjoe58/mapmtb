<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SirJoeMTB" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sj_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#FFE0B2</item>
        <item name="colorSecondary">@color/sj_green</item>
        <item name="colorAccent">@color/sj_orange</item>
        <item name="android:statusBarColor">@color/sj_dark</item>
    </style>

    <style name="Logo">
        <item name="android:background">@drawable/bg_logo</item>
        <item name="android:text">@string/logo_text</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
</resources>
