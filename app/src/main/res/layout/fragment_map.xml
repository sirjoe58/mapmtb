<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mappa a tutto schermo -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Logo in alto a sinistra, piccolo e discreto -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:adjustViewBounds="true"
        android:alpha="0.92"
        android:contentDescription="@string/logo_text"
        android:src="@drawable/logo_sirjoe" />

    <!-- Avvisi percorso (fuori percorso / distanza al traguardo) -->
    <TextView
        android:id="@+id/routeBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_banner"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Fantasma e salite in arrivo -->
    <TextView
        android:id="@+id/coachBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="90dp"
        android:background="@drawable/bg_banner"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Pulsanti flottanti a destra (si nascondono durante l'uscita) -->
    <LinearLayout
        android:id="@+id/sideBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/cd_layers"
            app:backgroundTint="@color/fab_bg"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_layers"
            app:tint="@color/sj_dark" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/cd_heading"
            app:backgroundTint="@color/fab_bg"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_navigation"
            app:tint="@color/sj_dark" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/cd_center"
            app:backgroundTint="@color/fab_bg"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_my_location"
            app:tint="@color/sj_dark" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/cd_record"
            app:backgroundTint="@color/sj_orange"
            app:srcCompat="@drawable/ic_play"
            app:tint="@color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_stop"
            android:visibility="gone"
            app:backgroundTint="@color/sj_red"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_stop"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Barra dati in basso: velocità, ora al centro, distanza. Cifre grandi uguali,
         barra semitrasparente per vedere la mappa sotto. -->
    <LinearLayout
        android:id="@+id/dataBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/data_bar"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/speed"
                    style="@style/BigValue"
                    android:text="0,0" />

                <TextView
                    style="@style/BigUnit"
                    android:text="@string/unit_kmh" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_clock"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock"
                    style="@style/BigValue"
                    android:text="00:00"
                    android:textColor="@color/clock_text" />

                <TextView
                    style="@style/BigUnit"
                    android:text="ora"
                    android:textColor="@color/clock_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/distance"
                    style="@style/BigValue"
                    android:text="0,00" />

                <TextView
                    android:id="@+id/distanceUnit"
                    style="@style/BigUnit"
                    android:text="km" />
            </LinearLayout>
        </LinearLayout>

        <!-- Riga espandibile con un tocco sulla barra -->
        <LinearLayout
            android:id="@+id/extraRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/extraTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/extraAscent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/extraAlt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
